{
  "name": "lnai",
  "version": "0.6.92",
  "description": "CLI tool that syncs a unified .ai/ config to native formats for AI coding tools",
  "type": "module",
  "license": "MIT",
  "author": "Krystian Jonca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrystianJonca/lnai.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/KrystianJonca/lnai/issues"
  },
  "homepage": "https://github.com/KrystianJonca/lnai#readme",
  "keywords": [
    "ai",
    "config",
    "configuration",
    "claude",
    "cursor",
    "gemini",
    "antigravity",
    "opencode",
    "copilot",
    "github-copilot",
    "windsurf",
    "cli",
    "ai-tools",
    "lnai"
  ],
  "bin": {
    "lnai": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "cp ../../README.md .",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@lnai/core": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@lnai/typescript-config": "workspace:*",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
