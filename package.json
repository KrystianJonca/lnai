{
  "name": "lnai",
  "version": "0.1.1",
  "private": true,
  "description": "CLI tool that syncs a unified .ai/ config to native formats for AI coding tools",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "knip": "knip",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write .",
    "format:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@lnai/eslint-config": "workspace:*",
    "@lnai/prettier-config": "workspace:*",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "lnai": "^0.6.91",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "brace-expansion": "^5.0.9",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "postcss": "^8.5.23",
      "sharp": "^0.35.3",
      "svgo": "^4.0.2"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yaml,yml}": [
      "pnpm exec prettier --write"
    ]
  }
}
